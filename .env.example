# Backend (copy to backend/.env)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://minutemate:minutemate@localhost:5433/minutemate
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
OPENAI_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (copy the NEXT_PUBLIC_API_URL line to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
