# Backend (copy to backend/.env)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://minutemate:minutemate@localhost:5433/minutemate
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
ASSEMBLYAI_API_KEY=
# Local dev can use Ollama; APP_ENV=production forces the rule-based fallback.
EXTRACTION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (copy to frontend/.env.local if your backend uses another address)
BACKEND_API_ORIGIN=http://127.0.0.1:8001
